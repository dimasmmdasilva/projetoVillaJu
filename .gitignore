# ---------------------------------------------------------------------------
# Projeto VillaJu - arquivos que NUNCA podem entrar no repositório.
#
# Este arquivo e criado no primeiro commit, antes de qualquer código:
# segredo que entra no histórico do Git não sai sem reescrever o histórico.
# Conteudo obrigatório definido na seção 8.1 do contexto do projeto.
# ---------------------------------------------------------------------------

# Segredos e chaves - as três chaves do projeto vivem aqui, fora do Git
.env

# Certificados TLS locais (seção 6.5) - homologacao, não se reutiliza
certs/
*.key
*.crt
*.pem

# Artefatos do Python
__pycache__/
*.pyc
venv/
.venv/

# Bancos e dumps - podem conter dado pessoal, ainda que ficticio
*.sqlite
*.sql.gz
backups/

# Ferramentas e editor
.pytest_cache/
.vscode/

# ---------------------------------------------------------------------------
# Acrescimos ao mínimo obrigatório
# ---------------------------------------------------------------------------
# Documento de contexto do projeto - uso interno do grupo, não versionado
contexto.md

# Documentação técnica de desenvolvimento - material interno do grupo.
# Cobre o nome antigo (entrega2_etapaN_documentacao_tecnica.md) e o atual
# (docs/etapaN.md). O modelo entidade-relacionamento NÃO entra aqui: ele é
# entregável e continua versionado.
*_documentacao_tecnica.md
docs/etapa*.md

# Variantes locais do .env, para que nenhuma escape por nome diferente
.env.*
!.env.example

# Saidas das ferramentas de análise (seção 7.2) - evidencia, não código
.semgrep/
bandit-*.json
semgrep-*.json
gitleaks-*.json

# Ambiente e sistema operacional
*.log
.idea/
Thumbs.db
desktop.ini

# Ambiente separado das ferramentas de análise
venv-ferramentas/

# Geração do relatório consolidado da Entrega 2. O script e o .docx ficam
# fora do versionamento: o documento é material de entrega, não código, e
# node_modules não tem por que entrar num repositório Python.
gerar_relatorio.js
node_modules/
package-lock.json
package.json
*.docx
