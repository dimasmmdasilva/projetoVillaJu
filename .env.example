# ---------------------------------------------------------------------------
# Projeto VillaJu - modelo de configuracao.
#
# Este arquivo E versionado e NAO contem valor real nenhum. Ele existe para
# documentar quais variaveis o sistema exige.
#
# Para criar o seu ambiente local:
#   1. copie este arquivo:        cp .env.example .env
#   2. gere as chaves:            python scripts/gerar_chaves.py
#   3. cole a saida no .env e preencha a senha do banco
#
# O .env esta no .gitignore e nunca deve ser commitado, compartilhado em
# conversa ou anexado em entrega. Cada integrante tem o seu.
# ---------------------------------------------------------------------------

# --- Chaves criptograficas -------------------------------------------------
# 32 bytes em base64, geradas por scripts/gerar_chaves.py.
# Sao tres chaves DIFERENTES de proposito: reutilizar a mesma para dois fins
# criptograficos distintos e ma pratica e impede rotacao independente.

# AES-256-GCM dos dados pessoais do hospede (secao 6.2)
# ATENCAO: perder esta chave torna os dados ja gravados irrecuperaveis.
VILLAJU_CHAVE_CIFRAGEM=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# HMAC-SHA256 dos campos _busca, que permitem consultar campo cifrado
VILLAJU_CHAVE_INDICE=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# Assinatura do cookie de sessao do Flask
VILLAJU_SECRET_KEY=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# --- Banco de dados --------------------------------------------------------
# A aplicacao NAO se conecta como root. O usuario abaixo e criado em
# banco/03_usuario_app.sql com privilegio minimo (secao 5.3).
VILLAJU_DB_HOST=localhost
VILLAJU_DB_PORTA=3306
VILLAJU_DB_NOME=villaju
VILLAJU_DB_USUARIO=villaju_app
VILLAJU_DB_SENHA=DEFINA_UMA_SENHA_FORTE_LOCAL

# --- TLS -------------------------------------------------------------------
# Certificado autoassinado gerado por OpenSSL (secao 6.5). A pasta certs/
# esta no .gitignore: o certificado e de homologacao e nao se reutiliza.
VILLAJU_TLS_CERT=certs/villaju.crt
VILLAJU_TLS_CHAVE=certs/villaju.key

# --- Aplicacao -------------------------------------------------------------
# Em producao, 0 - detalhe de erro so no log, nunca na resposta (secao 6.4).
VILLAJU_DEBUG=1
VILLAJU_HOST=127.0.0.1
VILLAJU_PORTA=5000
