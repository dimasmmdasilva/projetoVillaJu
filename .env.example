# ---------------------------------------------------------------------------
# Projeto VillaJu - modelo de configuração.
#
# Este arquivo E versionado e NAO contem valor real nenhum. Ele existe para
# documentar quais variáveis o sistema exige.
#
# Para criar o seu ambiente local:
#   1. copie este arquivo:        cp .env.example .env
#   2. gere as chaves:            python scripts/gerar_chaves.py
#   3. cole a saída no .env e preencha a senha do banco
#
# O .env esta no .gitignore e nunca deve ser commitado, compartilhado em
# conversa ou anexado em entrega. Cada integrante tem o seu.
# ---------------------------------------------------------------------------

# --- Chaves criptográficas -------------------------------------------------
# 32 bytes em base64, geradas por scripts/gerar_chaves.py.
# Sao três chaves DIFERENTES de propósito: reutilizar a mesma para dois fins
# criptográficos distintos e ma prática e impede rotação independente.

# AES-256-GCM dos dados pessoais do hóspede (seção 6.2)
# ATENCAO: perder esta chave torna os dados ja gravados irrecuperáveis.
VILLAJU_CHAVE_CIFRAGEM=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# HMAC-SHA256 dos campos _busca, que permitem consultar campo cifrado
VILLAJU_CHAVE_INDICE=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# Assinatura do cookie de sessão do Flask
VILLAJU_SECRET_KEY=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# --- Banco de dados --------------------------------------------------------
# A aplicação NAO se conecta como root. O usuário abaixo e criado em
# banco/03_usuario_app.sql com privilegio mínimo (seção 5.3).
VILLAJU_DB_HOST=localhost
VILLAJU_DB_PORTA=3306
VILLAJU_DB_NOME=villaju
VILLAJU_DB_USUARIO=villaju_app
VILLAJU_DB_SENHA=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# --- Banco de dados de teste -----------------------------------------------
# A suíte automatizada cria e apaga tabelas a cada execução, então nunca toca
# o banco real. O usuário villaju_teste tem privilégio total sobre este banco
# e nenhum sobre qualquer outro - menor privilégio vale também nos testes.
VILLAJU_DB_NOME_TESTE=villaju_teste
VILLAJU_DB_USUARIO_TESTE=villaju_teste
VILLAJU_DB_SENHA_TESTE=GERE_COM_O_SCRIPT_NAO_USE_ESTE_VALOR

# --- TLS -------------------------------------------------------------------
# Certificado autoassinado gerado por OpenSSL (seção 6.5). A pasta certs/
# esta no .gitignore: o certificado e de homologacao e não se reutiliza.
VILLAJU_TLS_CERT=certs/villaju.crt
VILLAJU_TLS_CHAVE=certs/villaju.key

# --- Aplicacao -------------------------------------------------------------
# Em produção, 0 - detalhe de erro so no log, nunca na resposta (seção 6.4).
VILLAJU_DEBUG=1
VILLAJU_HOST=127.0.0.1
VILLAJU_PORTA=5000

# --- Correio ---------------------------------------------------------------
# Dois modos. `arquivo` grava a mensagem em instance/emails/ e e o padrao:
# o sistema funciona sem nenhuma configuracao de SMTP, e a demonstracao
# roda sem rede. `smtp` envia de verdade.
VILLAJU_EMAIL_MODO=arquivo
VILLAJU_EMAIL_REMETENTE=VillaJu Reservas <seu-endereco@gmail.com>
VILLAJU_EMAIL_PASTA=instance/emails

# Endereco publico usado para montar o link de confirmacao. Vem daqui, e
# nao do cabecalho Host da requisicao: adivinhar pelo cabecalho permitiria
# a um atacante fazer o link do e-mail apontar para o sitio dele.
#
# NAO e o mesmo que VILLAJU_HOST, que e o endereco de escuta. Use aqui o
# endereco pelo qual voce navega, ou o link do e-mail levara a uma ORIGEM
# diferente: a excecao de certificado e o cookie de sessao nao atravessam
# de localhost para 127.0.0.1.
VILLAJU_EMAIL_BASE_URL=https://localhost:5000

# Preencher apenas no modo smtp. A senha e a SENHA DE APP do Google, de 16
# caracteres, SEM OS ESPACOS que a tela do Google exibe. Nunca a senha da
# conta. Gerada em myaccount.google.com/apppasswords, com verificacao em
# duas etapas ativa. Revogavel a qualquer momento, sem mexer na conta.
VILLAJU_SMTP_HOST=smtp.gmail.com
VILLAJU_SMTP_PORTA=587
VILLAJU_SMTP_USUARIO=seu-endereco@gmail.com
VILLAJU_SMTP_SENHA=COLE_A_SENHA_DE_APP_AQUI_SEM_ESPACOS

# --- Janela do cadastro nao confirmado -------------------------------------
# Quantos minutos o cadastro tem para ser confirmado pelo link do e-mail.
# Passado o prazo, o link deixa de valer E os dados sao descartados,
# liberando o endereco e o documento para uma nova tentativa.
#
# Cinco minutos e o padrao do codigo. Para a PRIMEIRA prova com SMTP real,
# use 15: filtro de spam e aplicativo de celular que sincroniza por
# agendamento podem consumir varios minutos, e um cadastro que expira
# enquanto se espera o e-mail parece defeito sem ser.
#
# Medir a latencia real da conta de envio antes de baixar para 5.
VILLAJU_CADASTRO_MINUTOS=15
